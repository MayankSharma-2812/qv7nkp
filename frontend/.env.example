# WindScope Frontend Environment Configuration

# 1. Local Development (Default if unset):
# VITE_API_BASE_URL=http://localhost:8000

# 2. Docker Compose (Same-origin Nginx proxy - leave empty or unset):
# VITE_API_BASE_URL=

# 3. Production Deployment (e.g. Vercel pointing to Render Docker backend):
# VITE_API_BASE_URL=https://<your-render-service-name>.onrender.com
